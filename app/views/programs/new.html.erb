<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">New Program</h1>
  <p class="text-gray-600 mb-6">Department: <%= link_to @department.name, department_path(@department), class: "text-blue-600 hover:text-blue-800" %></p>

  <%= render "shared/page_instructions",
      page_path: "programs/new",
      default_text: "Create a new program for a department. Set open and close dates, questionnaire due date, and the dates when program events occur. The default appointment length is used when creating individual appointments." %>

  <%= form_with model: [@department, @program], class: "bg-white shadow rounded-lg p-6" do |form| %>
    <% if @program.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
        <h2 class="font-bold"><%= pluralize(@program.errors.count, "error") %> prohibited this program from being saved:</h2>
        <ul class="list-disc list-inside mt-2">
          <% @program.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= required_fields_note %>

    <div class="mb-4">
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
        Name<%= required_asterisk %>
      <% end %>
      <%= form.text_field :name, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :open_date, "Open Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.datetime_local_field :open_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= form.label :close_date, "Close Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.datetime_local_field :close_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="mb-4">
      <%= form.label :questionnaire_due_date, "Questionnaire Due Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.datetime_local_field :questionnaire_due_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <fieldset class="mb-4">
      <legend class="block text-sm font-medium text-gray-700 mb-2">Program Held-On Dates (dates when the program events occur)</legend>
      <div id="held-on-dates-container" class="space-y-2" data-held-on-date-count="0">
        <div id="add-date-row" class="flex gap-2 items-end">
          <div>
            <label for="program_held_on_date_new" class="block text-xs font-medium text-gray-700 mb-1">Date</label>
            <%= date_field_tag "program[held_on_dates][]", nil, id: "program_held_on_date_new", class: "px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <button type="button" onclick="addHeldOnDateField()" class="bg-blue-600 text-white btn-responsive rounded hover:bg-blue-700 text-sm">Add Date</button>
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-1">Add all dates when program events will occur (e.g., March 21, 22, 23)</p>
    </fieldset>

    <div class="mb-4">
      <%= form.label :default_appointment_length, class: "block text-sm font-medium text-gray-700 mb-2" do %>
        Default Appointment Length (minutes)<%= required_asterisk %>
      <% end %>
      <%= form.number_field :default_appointment_length, value: 30, min: 1, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="mb-4">
      <%= form.label :google_map_url, "Google Map URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :google_map_url, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="mb-4">
      <%= form.label :information_email_address, class: "block text-sm font-medium text-gray-700 mb-2" do %>
        Information Email Address<%= required_asterisk %>
      <% end %>
      <%= form.email_field :information_email_address, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", placeholder: "e.g., program-info@lsa.umich.edu" %>
      <p class="text-xs text-gray-500 mt-1">This email address will be displayed in student welcome emails as a contact for program questions.</p>
    </div>

    <div class="mb-4">
      <%= form.label :active, class: "flex items-center" do %>
        <%= form.check_box :active, class: "mr-2" %>
        <span class="text-sm font-medium text-gray-700">Set as active program (only one active program per department)</span>
      <% end %>
    </div>

    <div class="flex justify-end space-x-4">
      <%= form.submit "Create Program", class: "bg-green-600 text-white btn-responsive rounded hover:bg-green-700" %>
      <%= link_to "Cancel", department_programs_path(@department), class: "bg-gray-600 text-white btn-responsive rounded hover:bg-gray-700" %>
    </div>
  <% end %>
</div>

<script>
  // Escape HTML special characters to prevent XSS
  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function nextHeldOnDateFieldId(container) {
    let max = 0;
    container.querySelectorAll('input[type="date"][id^="program_held_on_date_"]').forEach(function(input) {
      const match = input.id.match(/^program_held_on_date_(\d+)$/);
      if (match) {
        max = Math.max(max, parseInt(match[1], 10));
      }
    });
    const stored = parseInt(container.dataset.heldOnDateCount || '0', 10);
    max = Math.max(max, stored);
    const next = max + 1;
    container.dataset.heldOnDateCount = String(next);
    return 'program_held_on_date_' + next;
  }

  function addHeldOnDateField() {
    const container = document.getElementById('held-on-dates-container');
    const addDateRow = document.getElementById('add-date-row');
    const dateInput = addDateRow.querySelector('input[type="date"]');
    const dateValue = dateInput.value;

    // Only add if there's a date value
    if (dateValue) {
      const fieldId = nextHeldOnDateFieldId(container);
      // Create a new row with the date and Remove button
      const newField = document.createElement('div');
      newField.className = 'flex gap-2 items-end';
      newField.innerHTML = `
        <div>
          <label for="${fieldId}" class="block text-xs font-medium text-gray-700 mb-1">Date</label>
          <input type="date" name="program[held_on_dates][]" id="${fieldId}" value="${escapeHtml(dateValue)}" class="px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" />
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="bg-red-600 text-white btn-responsive rounded hover:bg-red-700 text-sm">Remove</button>
      `;

      // Insert before the add-date-row
      container.insertBefore(newField, addDateRow);

      // Clear the input field for the next date
      dateInput.value = '';
    }
  }
</script>
